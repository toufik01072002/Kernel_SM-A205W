# ==============================================================================
# Fragment defconfig - SM-A205W (Exynos 7885 / Kernel 4.4.177)
# Activation Wi-Fi (SCSC WLAN) + Bluetooth (SCSC BlueZ) pour Alpine Linux
# ==============================================================================

# --- Localisation directe du firmware MX140 (sans attente de /system ou /vendor) ---
# CONFIG_SCSC_CORE_FW_LOCATION_AUTO is not set
CONFIG_SCSC_CORE_FW_LOCATION="/lib/firmware/postmarketos/mx140"
CONFIG_SCSC_CORE_TOOL_LOCATION="/usr/bin"

# --- Pile Bluetooth standard Linux (BlueZ) ---
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HS=y
CONFIG_BT_LE=y
CONFIG_BT_DEBUGFS=y

# --- Passerelle Samsung SCSC vers BlueZ (scsc_bluez.c) ---
# Note: Verifier dans drivers/misc/samsung/scsc/Kconfig le nom exact du symbole
# (generalement CONFIG_SCSC_BT_BLUEZ=y ou CONFIG_SCSC_BT=y sans H4 Android)
CONFIG_SCSC_CORE=y
CONFIG_SCSC_BT=y
CONFIG_SCSC_BT_BLUEZ=y
# CONFIG_SCSC_BT_H4 is not set

# --- Wi-Fi Samsung SCSC WLAN ---
CONFIG_SCSC_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WIRELESS=y
